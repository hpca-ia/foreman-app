{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-pipeline",
      "schedule": "0 12 * * 1-6"
    },
    {
      "path": "/api/cron-respaldo",
      "schedule": "30 7 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "refactor/design-system": false
    }
  }
}
